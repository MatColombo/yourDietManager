@@ -0,0 +1,121 @@
+name: Controlled Scale to 500 Recipes
+
+on:
+  workflow_dispatch:
+    inputs:
+      commit_results:
+        description: Commit the verified 500-recipe working bundle and audit evidence to the invoking branch
+        required: true
+        default: false
+        type: boolean
+
+permissions:
+  contents: write
+
+concurrency:
+  group: controlled-scale-500-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  controlled-scale-500:
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+        with:
+          ref: ${{ github.ref }}
+
+      - name: Setup Node
+        uses: actions/setup-node@v7
+        with:
+          node-version: 22
+
+      - name: Validate 4P-D control plane and committed production baseline
+        run: |
+          npm run corpus:4pd
+          npm run lint
+          npm test
+          test -f corpus/production/current-working-bundle.json
+          node --input-type=module <<'NODE'
+          import fs from 'node:fs';
+          const bundle = JSON.parse(fs.readFileSync('corpus/production/current-working-bundle.json','utf8'));
+          const active = (bundle.recipeFamilies || []).filter(item => item.status === 'active').length;
+          if (active !== 220) throw new Error(`Controlled Scale Pass A requires the committed 220-recipe baseline; got ${active}`);
+          NODE
+
+      - name: Tranche 1 - breakfast and snack 220 to 320
+        run: |
+          npm run corpus:scale-to-500 -- \
+            corpus/production/current-working-bundle.json \
+            corpus/staging/runtime/controlled-scale-500/tranche-01 \
+            --tranche=1 \
+            --canonical
+
+      - name: Tranche 2 - lunch and dinner 320 to 420
+        run: |
+          npm run corpus:scale-to-500 -- \
+            corpus/production/current-working-bundle.json \
+            corpus/staging/runtime/controlled-scale-500/tranche-02 \
+            --tranche=2 \
+            --canonical
+
+      - name: Tranche 3 - balanced close 420 to 500
+        run: |
+          npm run corpus:scale-to-500 -- \
+            corpus/production/current-working-bundle.json \
+            corpus/staging/runtime/controlled-scale-500/tranche-03 \
+            --tranche=3 \
+            --canonical
+
+      - name: Verify Scale Gate 500 and regression suite
+        run: |
+          npm run corpus:scale-gate-500 -- \
+            corpus/production/current-working-bundle.json \
+            corpus/staging/runtime/controlled-scale-500/final-scale-gate-verified.json \
+            corpus/staging/runtime/controlled-scale-500/final-snapshot-verified.json \
+            --strict
+          node scripts/corpus/production-readiness.mjs \
+            corpus/production/current-working-bundle.json \
+            corpus/contracts/v1-production.json \
+            corpus/policies/v1-default.json \
+            corpus/staging/runtime/controlled-scale-500/final-readiness.json
+          npm run corpus:4pd
+          npm run lint
+          npm test
+
+      - name: Upload controlled-scale evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: controlled-scale-500-${{ github.run_number }}
+          path: |
+            corpus/production/current-working-bundle.json
+            corpus/production/evidence/controlled-scale-500-summary.json
+            corpus/production/evidence/controlled-scale-500-tranches.json
+            corpus/reports/scale-gate-500.json
+            corpus/snapshots/scale-gate-500-current.json
+            corpus/staging/runtime/controlled-scale-500
+          if-no-files-found: warn
+          retention-days: 14
+
+      - name: Commit verified 500-recipe working set
+        if: ${{ inputs.commit_results }}
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add \
+            corpus/production/current-working-bundle.json \
+            corpus/production/evidence/controlled-scale-500-summary.json \
+            corpus/production/evidence/controlled-scale-500-tranches.json \
+            corpus/reports \
+            corpus/snapshots \
+            corpus/runs \
+            corpus/jobs \
+            corpus/intake
+          if git diff --cached --quiet; then
+            echo "No controlled-scale corpus changes to commit"
+          else
+            git commit -m "data: scale production corpus to 500 recipes"
+            git push origin HEAD:${GITHUB_REF_NAME}
+          fi
