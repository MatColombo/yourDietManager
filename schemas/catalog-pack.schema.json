{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yourdietmanager.local/schemas/catalog-pack.schema.json",
  "title": "CatalogPack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "catalogVersion",
    "labelKey",
    "descriptionKey",
    "required",
    "estimatedBytes",
    "recipeVersionIds",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "type": "string",
      "minLength": 1
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "labelKey": {
      "type": "string",
      "minLength": 1
    },
    "descriptionKey": {
      "type": "string",
      "minLength": 1
    },
    "required": {
      "type": "boolean"
    },
    "estimatedBytes": {
      "type": "integer",
      "minimum": 0
    },
    "recipeVersionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "available",
        "installing",
        "installed",
        "failed",
        "retired"
      ]
    },
    "installedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lastErrorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
