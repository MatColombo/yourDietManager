{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yourdietmanager.local/schemas/ingredient-curation-batch.schema.json",
  "title": "IngredientCurationBatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "policyId",
    "policyVersion",
    "source",
    "inputFoodCount",
    "completeRequiredNutrientCount",
    "incompleteRequiredNutrientCount",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "batchId": {
      "type": "string",
      "minLength": 1
    },
    "policyId": {
      "type": "string",
      "minLength": 1
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "provider",
        "dataset",
        "release",
        "reference",
        "archive",
        "license",
        "inputDigest",
        "importedAt"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "archive": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "inputDigest": {
          "type": "string",
          "minLength": 16
        },
        "importedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "inputFoodCount": {
      "type": "integer",
      "minimum": 0
    },
    "completeRequiredNutrientCount": {
      "type": "integer",
      "minimum": 0
    },
    "incompleteRequiredNutrientCount": {
      "type": "integer",
      "minimum": 0
    },
    "structurallyInvalidFoodCount": {
      "type": "integer",
      "minimum": 0
    },
    "structurallyInvalidFoodExamples": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "reason"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "enum": [
              "null_food_record",
              "non_object_food_record",
              "missing_fdc_id"
            ]
          }
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRecordId",
        "description",
        "commonName",
        "category",
        "nutrition",
        "suggested",
        "review"
      ],
      "properties": {
        "sourceRecordId": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "commonName": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": "string"
        },
        "nutrition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "energyKcal",
            "proteinG",
            "carbsG",
            "fatG",
            "fiberG",
            "sugarsG",
            "saturatedFatG",
            "sodiumMg"
          ],
          "properties": {
            "energyKcal": {
              "type": "number",
              "minimum": 0
            },
            "proteinG": {
              "type": "number",
              "minimum": 0
            },
            "carbsG": {
              "type": "number",
              "minimum": 0
            },
            "fatG": {
              "type": "number",
              "minimum": 0
            },
            "fiberG": {
              "type": "number",
              "minimum": 0
            },
            "sugarsG": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "saturatedFatG": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "sodiumMg": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "energyBasis": {
              "enum": [
                "atwater_general",
                "atwater_specific",
                "legacy_energy",
                "unknown"
              ]
            },
            "energyNutrientId": {
              "type": [
                "string",
                "null"
              ]
            },
            "energySourceUnit": {
              "enum": [
                "kcal",
                "kJ",
                "unknown"
              ]
            },
            "energyOriginalValue": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "energyConversion": {
              "enum": [
                "none",
                "kj_to_kcal",
                "assumed_kcal_by_nutrient_id"
              ]
            }
          }
        },
        "suggested": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ingredientId",
            "nameEn",
            "nameIt",
            "aliasesEn",
            "aliasesIt",
            "foodGroup",
            "foodSubgroup",
            "flavorProfile",
            "mealArchetypes",
            "state",
            "allergenIds",
            "conversions"
          ],
          "properties": {
            "ingredientId": {
              "type": "string",
              "minLength": 1
            },
            "nameEn": {
              "type": "string",
              "minLength": 1
            },
            "nameIt": {
              "type": "string"
            },
            "aliasesEn": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "aliasesIt": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "foodGroup": {
              "type": "string",
              "minLength": 1
            },
            "foodSubgroup": {
              "type": [
                "string",
                "null"
              ]
            },
            "flavorProfile": {
              "type": "string",
              "minLength": 1
            },
            "mealArchetypes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "domain-enums.schema.json#/$defs/mealArchetype"
              }
            },
            "state": {
              "enum": [
                "raw",
                "cooked",
                "dry",
                "drained",
                "prepared",
                "ready_to_eat",
                "as_sold",
                "unknown"
              ]
            },
            "allergenIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "domain-enums.schema.json#/$defs/allergenId"
              }
            },
            "conversions": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "approved",
            "checks",
            "reviewer",
            "reviewedAt",
            "notes",
            "duplicateOfIngredientId"
          ],
          "properties": {
            "decision": {
              "enum": [
                "pending",
                "approved",
                "rejected"
              ]
            },
            "approved": {
              "type": "boolean"
            },
            "checks": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "italianLabel",
                "taxonomy",
                "state",
                "allergens",
                "culinarySuitability",
                "duplicate",
                "nutrition",
                "source"
              ],
              "properties": {
                "italianLabel": {
                  "type": "boolean"
                },
                "taxonomy": {
                  "type": "boolean"
                },
                "state": {
                  "type": "boolean"
                },
                "allergens": {
                  "type": "boolean"
                },
                "culinarySuitability": {
                  "type": "boolean"
                },
                "duplicate": {
                  "type": "boolean"
                },
                "nutrition": {
                  "type": "boolean"
                },
                "source": {
                  "type": "boolean"
                }
              }
            },
            "reviewer": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "notes": {
              "type": [
                "string",
                "null"
              ]
            },
            "duplicateOfIngredientId": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
