              ],
              "minimum": 0
            },
            "max": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "weight": {
              "type": "number",
              "minimum": 0
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": false
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "properties": {
                  "min": {
                    "type": "null"
                  },
                  "target": {
                    "type": "null"
                  },
                  "max": {
                    "type": "null"
                  },
                  "weight": {
                    "const": 0
                  }
                }
              }
            }
          ]
        }
      }
    },
    "dayArchetypeModifiers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "value"
        ],
        "properties": {
          "mode": {
            "enum": [
              "kcal",
              "percent"
            ]
          },
          "value": {
            "type": "number",
            "minimum": -1000,
            "maximum": 1000
          }
        }
      }
    }
  }
}
