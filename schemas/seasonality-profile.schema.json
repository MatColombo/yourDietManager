{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yourdietmanager.local/schemas/seasonality-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "name",
    "entries",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conceptId",
          "months",
          "sourceRef",
          "reviewedAt"
        ],
        "properties": {
          "conceptId": {
            "type": "string",
            "minLength": 1
          },
          "months": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 12
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "reviewedAt": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "minItems": 1,
      "maxItems": 500
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
