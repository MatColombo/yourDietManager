{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yourdietmanager.local/schemas/cycle.schema.json",
  "title": "Cycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "length",
    "days"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 31,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cycleDay",
          "dayClassId"
        ],
        "properties": {
          "cycleDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "dayClassId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
