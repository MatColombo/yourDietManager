{
  "name": "yourdietmanager",
  "private": true,
  "version": "1.0.0-rc.6",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "hardening:a11y": "node scripts/hardening/a11y-audit.mjs",
    "hardening:scale": "node scripts/hardening/scale-benchmark.mjs",
    "release:gate": "node scripts/hardening/release-gate.mjs",
    "check": "npm run corpus:smoke && npm run planner:smoke && npm run lint && npm run test && npm run hardening:a11y && npm run hardening:forms && npm run hardening:scale && npm run build && npm run hardening:browser && npm run hardening:revision && npm run pages:audit",
    "corpus:scan": "node scripts/corpus/scan.mjs",
    "corpus:plan": "node scripts/corpus/plan.mjs",
    "corpus:smoke": "node scripts/corpus/build-phase4-smoke.mjs",
    "corpus:import-usda": "node scripts/corpus/import-usda-foundation.mjs",
    "corpus:materialize-usda": "node scripts/corpus/materialize-usda-reviewed.mjs",
    "corpus:process": "node scripts/corpus/process-batch.mjs",
    "corpus:apply": "node scripts/corpus/apply-batch.mjs",
    "corpus:publish": "node scripts/corpus/publish-release.mjs",
    "planner:smoke": "node scripts/planner/build-phase5-smoke.mjs",
    "pages:audit": "node scripts/hardening/pages-audit.mjs dist",
    "hardening:forms": "node scripts/hardening/form-contract-audit.mjs",
    "hardening:browser": "node scripts/hardening/browser-regression.mjs",
    "hardening:revision": "node scripts/hardening/revision-closure.mjs"
