{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yourdietmanager.local/schemas/recipe-generation-job.schema.json",
  "title": "RecipeGenerationJob",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "targetCatalogVersion",
    "referenceDataVersion",
    "referenceDataDigest",
    "seed",
    "pipelineVersion",
    "sourceLocale",
    "requiredLocales",
    "targetAcceptedCount",
    "candidateCount",
    "mealArchetypes",
    "energyKcal",
    "coverageTargets",
    "allowedIngredientIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "sourceLocale": {
      "type": "string",
      "minLength": 2
    },
    "requiredLocales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "targetAcceptedCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "candidateCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "mealArchetypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "domain-enums.schema.json#/$defs/mealArchetype"
      },
      "uniqueItems": true
    },
    "energyKcal": {
      "$ref": "#/$defs/range"
    },
    "proteinG": {
      "oneOf": [
        {
          "$ref": "#/$defs/range"
        },
        {
          "type": "null"
        }
      ]
    },
    "fiberG": {
      "oneOf": [
        {
          "$ref": "#/$defs/range"
        },
        {
          "type": "null"
        }
      ]
    },
    "maxTotalMinutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "recipeFamilies": {
      "$ref": "#/$defs/stringSet"
    },
    "cuisineFocus": {
      "$ref": "#/$defs/stringSet"
    },
    "practicalityTargets": {
      "$ref": "#/$defs/stringSet"
    },
    "requiredTags": {
      "$ref": "#/$defs/stringSet"
    },
    "forbiddenTags": {
      "$ref": "#/$defs/stringSet"
    },
    "preferredUnderusedIngredientIds": {
      "$ref": "#/$defs/stringSet"
    },
    "diversityTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minDistinctPrimaryIngredients",
        "minDistinctIngredientIds",
        "maxPrimaryIngredientFrequency",
        "maxIngredientPairFrequency"
      ],
      "properties": {
        "minDistinctPrimaryIngredients": {
          "type": "integer",
          "minimum": 1
        },
        "minDistinctIngredientIds": {
          "type": "integer",
          "minimum": 1
        },
        "maxPrimaryIngredientFrequency": {
          "type": "integer",
          "minimum": 1
        },
        "maxIngredientPairFrequency": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "coverageTargets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetId",
          "key",
          "desiredAcceptedGain"
        ],
        "properties": {
          "targetId": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "desiredAcceptedGain": {
            "type": "integer",
            "minimum": 1
          },
          "dimension": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "meal_archetype",
              "energy_band",
              "protein_band",
              "fiber_band",
              "practicality",
              "diet",
              "recipe_family",
              "cuisine",
              "ingredient_category",
              null
            ]
          },
          "criteria": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/coverageCriterion"
            }
          }
        }
      }
    },
    "allowedIngredientIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "orchestration": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "runId",
        "inputSnapshotId",
        "policyId",
        "policyVersion",
        "plannedPriority",
        "targetIds",
        "reasons"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "inputSnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "policyId": {
          "type": "string",
          "minLength": 1
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "plannedPriority": {
          "type": "number"
        },
        "targetIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pipelineVersion": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "targetCatalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "referenceDataVersion": {
      "type": "string",
      "minLength": 1
    },
    "referenceDataDigest": {
      "type": "string",
      "minLength": 16
    },
    "productionContract": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "contractId",
        "contractVersion",
        "contractDigest"
      ],
      "properties": {
        "contractId": {
          "type": "string",
          "minLength": 3
        },
        "contractVersion": {
          "type": "string",
          "minLength": 1
        },
        "contractDigest": {
          "type": "string",
          "minLength": 16
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "stringSet": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "coverageCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "key"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "meal_archetype",
            "energy_band",
            "protein_band",
            "fiber_band",
            "practicality",
            "diet",
            "recipe_family",
            "cuisine",
            "ingredient_category"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
