{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yourdietmanager.local/schemas/recipe-corpus-policy.schema.json",
  "title": "RecipeCorpusPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "policyVersion",
    "plannerVersion",
    "targetCorpus",
    "batchPlanning",
    "scoreWeights",
    "energyBands",
    "proteinBands",
    "fiberBands",
    "coverageTargets",
    "diversity",
    "similarity",
    "releaseGates",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "policyId": {
      "type": "string",
      "minLength": 1
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "plannerVersion": {
      "type": "string",
      "minLength": 1
    },
    "targetCorpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "target",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "target": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "batchPlanning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultAcceptedCount",
        "minAcceptedCount",
        "maxAcceptedCount",
        "oversampleRatio",
        "maxCandidateCount",
        "candidateIntentLimit",
        "maxConsecutiveSamePrimaryFocus",
        "tieBreakStrategy",
        "stopWhenNoPositivePriority"
      ],
      "properties": {
        "defaultAcceptedCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "minAcceptedCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "maxAcceptedCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "oversampleRatio": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "maxCandidateCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "candidateIntentLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxConsecutiveSamePrimaryFocus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "tieBreakStrategy": {
          "const": "seeded_hash_then_lexical"
        },
        "stopWhenNoPositivePriority": {
          "type": "boolean"
        },
        "maxCoverageTargetsPerJob": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "scoreWeights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nutrition",
        "meal",
        "practicality",
        "cuisine",
        "ingredientDiversity",
        "recipeFamily",
        "focusBoost",
        "similarityPenalty",
        "ingredientOverusePenalty",
        "pairRepetitionPenalty"
      ],
      "properties": {
        "nutrition": {
          "type": "number",
          "minimum": 0
        },
        "meal": {
          "type": "number",
          "minimum": 0
        },
        "practicality": {
          "type": "number",
          "minimum": 0
        },
        "cuisine": {
          "type": "number",
          "minimum": 0
        },
        "ingredientDiversity": {
          "type": "number",
          "minimum": 0
        },
        "recipeFamily": {
          "type": "number",
          "minimum": 0
        },
        "focusBoost": {
          "type": "number",
          "minimum": 0
        },
        "similarityPenalty": {
          "type": "number",
          "minimum": 0
        },
        "ingredientOverusePenalty": {
          "type": "number",
          "minimum": 0
        },
        "pairRepetitionPenalty": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "energyBands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rangeBand"
      }
    },
    "proteinBands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rangeBand"
      }
    },
    "fiberBands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rangeBand"
      }
    },
    "coverageTargets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/coverageTarget"
      }
    },
    "diversity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryIngredientMaxShare",
        "ingredientOverusePenaltyStartShare",
        "repeatedPairMaxShare",
        "pairPenaltyStartShare",
        "minimumDistinctPrimaryIngredients",
        "exemptIngredientIds"
      ],
      "properties": {
        "primaryIngredientMaxShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ingredientOverusePenaltyStartShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "repeatedPairMaxShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pairPenaltyStartShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumDistinctPrimaryIngredients": {
          "type": "integer",
          "minimum": 1
        },
        "exemptIngredientIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "similarity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "highJaccardThreshold",
        "titleSimilarityThreshold",
        "nearDuplicateMaxShare"
      ],
      "properties": {
        "highJaccardThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "titleSimilarityThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nearDuplicateMaxShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "releaseGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSchemaErrors",
        "maxUnknownIngredientReferences",
        "maxNutritionErrors",
        "maxAllergenDerivationErrors",
        "maxExactDuplicates",
        "maxMissingRequiredLocaleFields"
      ],
      "properties": {
        "maxSchemaErrors": {
          "type": "integer",
          "minimum": 0
        },
        "maxUnknownIngredientReferences": {
          "type": "integer",
          "minimum": 0
        },
        "maxNutritionErrors": {
          "type": "integer",
          "minimum": 0
        },
        "maxAllergenDerivationErrors": {
          "type": "integer",
          "minimum": 0
        },
        "maxExactDuplicates": {
          "type": "integer",
          "minimum": 0
        },
        "maxMissingRequiredLocaleFields": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "rangeBand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bandId",
        "min",
        "max"
      ],
      "properties": {
        "bandId": {
          "type": "string",
          "minLength": 1
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "coverageTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "dimension",
        "key",
        "weight",
        "hardForRelease"
      ],
      "properties": {
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "enum": [
            "meal_archetype",
            "energy_band",
            "protein_band",
            "fiber_band",
            "practicality",
            "diet",
            "recipe_family",
            "cuisine",
            "ingredient_category"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "minCount": {
          "type": "integer",
          "minimum": 0
        },
        "desiredCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxCount": {
          "type": "integer",
          "minimum": 0
        },
        "minShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "desiredShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "hardForRelease": {
          "type": "boolean"
        },
        "criteria": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/coverageCriterion"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "minCount"
          ]
        },
        {
          "required": [
            "desiredCount"
          ]
        },
        {
          "required": [
            "maxCount"
          ]
        },
        {
          "required": [
            "minShare"
          ]
        },
        {
          "required": [
            "desiredShare"
          ]
        },
        {
          "required": [
            "maxShare"
          ]
        }
      ]
    },
    "coverageCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "key"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "meal_archetype",
            "energy_band",
            "protein_band",
            "fiber_band",
            "practicality",
            "diet",
            "recipe_family",
            "cuisine",
            "ingredient_category"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
