+name: Publish 500 Recipe Review Catalog
+
+on:
+  workflow_dispatch:
+    inputs:
+      commit_results:
+        description: Commit the verified production-review catalog and publication evidence to the invoking branch
+        required: true
+        default: false
+        type: boolean
+
+permissions:
+  contents: write
+
+concurrency:
+  group: production-review-500-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  publish-production-review-500:
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+        with:
+          ref: ${{ github.ref }}
+
+      - name: Setup Node
+        uses: actions/setup-node@v7
+        with:
+          node-version: 22
+
+      - name: Verify committed 500-recipe production checkpoint
+        run: |
+          npm run corpus:4pd
+          test -f corpus/production/current-working-bundle.json
+          node --input-type=module <<'NODE'
+          import fs from 'node:fs';
+          const bundle = JSON.parse(fs.readFileSync('corpus/production/current-working-bundle.json', 'utf8'));
+          const active = (bundle.recipeFamilies || []).filter(item => item.status === 'active').length;
+          if (active !== 500) throw new Error(`Production review publication requires the committed 500-recipe checkpoint; got ${active}`);
+          NODE
+          npm run corpus:scale-gate-500 -- \
+            corpus/production/current-working-bundle.json \
+            corpus/staging/runtime/production-review-500/prepublish-scale-gate.json \
+            corpus/staging/runtime/production-review-500/prepublish-snapshot.json \
+            --strict
+
+      - name: Publish controlled production-review catalog
+        run: |
+          npm run corpus:publish-review-500 -- \
+            corpus/production/current-working-bundle.json \
+            public \
+            1.0.0-production-review-500 \
+            --canonical
+          npm run corpus:validate-review-publication -- public/data --strict
+
+      - name: Verify application with the 500-recipe review catalog
+        run: |
+          npm run check
+          YDM_BASE_PATH=/yourDietManager/ npm run build
+          node scripts/hardening/pages-audit.mjs dist /yourDietManager/
+
+      - name: Upload production-review application artifact
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: production-review-500-${{ github.run_number }}
+          path: |
+            public/data/catalog-manifest.json
+            public/data/ingredients
+            public/data/recipes
+            public/data/reference-data
+            corpus/production/evidence/production-review-publication.json
+            corpus/staging/runtime/production-review-500
+            corpus/staging/runtime/production-review-publication
+            dist
+          if-no-files-found: warn
+          retention-days: 14
+
+      - name: Commit controlled review publication
+        if: ${{ inputs.commit_results }}
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add \
+            public/data/catalog-manifest.json \
+            public/data/ingredients \
+            public/data/recipes \
+            public/data/reference-data \
+            corpus/production/evidence/production-review-publication.json
+          if git diff --cached --quiet; then
+            echo "No production-review publication changes to commit"
+          else
+            git commit -m "data: publish 500-recipe production review catalog"
+            git push origin HEAD:${GITHUB_REF_NAME}
+          fi
